# -----------------------------------------------------------------------------
# Client build configuration (Vite). Copy to .env.local to override locally.
# -----------------------------------------------------------------------------

# Leave VITE_API_BASE_URL unset for local development (proxy mode): the client
# talks to the Node dev server at http://localhost:3001 (REST + WebSocket),
# which proxies the CloudFront ledger and hosts the LLM/MCP assistant.
#
# Set it to the CloudFront base URL for a client-only build (GitHub Pages).
# The client then calls the /api/v1/* REST API directly — no Node server needed:
#   VITE_API_BASE_URL=https://dxxxxxxxxxxxx.cloudfront.net
VITE_API_BASE_URL=

# Optional overrides:
# -------------------

# WebSocket endpoint. Proxy-mode default: ws://localhost:3001. Direct mode has
# no WebSocket through the CloudFront HTTP distribution — leave empty.
# VITE_WS_URL=ws://localhost:3001

# Assistant (chat) endpoint. Defaults per mode:
#   proxy:  <base>/api/assistant     (Node dev server)
#   direct: <base>/api/v1/assistant  (Lambda, forward-compatible)
# VITE_ASSISTANT_URL=
